# === Database (Postgres) ===
PAN_DB__HOST=localhost
PAN_DB__PORT=5432
PAN_DB__USER=pan
PAN_DB__PASSWORD=changeme
PAN_DB__NAME=pan

# === Redis ===
PAN_REDIS__HOST=localhost
PAN_REDIS__PORT=6379
PAN_REDIS__DB=0

# === Discord ===
PAN_DISCORD__TOKEN=your-bot-token
PAN_DISCORD__GUILD_ID=123456789012345678
PAN_DISCORD__ADMIN_USER_IDS=[123456789012345678,987654321098765432]

# === OpenRouter (LLM) ===
PAN_OPENROUTER__API_KEY=sk-or-v1-xxxx

# === Portainer (multi-instance) ===
PAN_PORTAINER__INSTANCES__MAIN__BASE_URL=https://portainer.local:9443
PAN_PORTAINER__INSTANCES__MAIN__API_KEY=ptr_xxxx
PAN_PORTAINER__INSTANCES__GPU__BASE_URL=https://gpu-host.local:9443
PAN_PORTAINER__INSTANCES__GPU__API_KEY=ptr_yyyy

# === TrueNAS Scale ===
PAN_TRUENAS__BASE_URL=https://truenas.local/api/v2.0
PAN_TRUENAS__API_KEY=1-xxxx

# === Proxmox VE ===
PAN_PROXMOX__BASE_URL=https://proxmox.local:8006
PAN_PROXMOX__API_TOKEN=root@pam!pan=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAN_PROXMOX__NODE_NAME=pve

# === UniFi (Cloud Gateway Max) ===
PAN_UNIFI__BASE_URL=https://192.168.1.1
PAN_UNIFI__API_KEY=your-unifi-api-key

# === General ===
PAN_DEBUG=false
PAN_LOG_LEVEL=INFO
